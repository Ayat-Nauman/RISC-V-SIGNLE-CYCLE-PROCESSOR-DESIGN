`include "alu_definitions.vh"

module imm_extender(
    input  [31:0] instruction,    // 32-bit instruction
    input  [1:0] ImmSrc,          // Immediate type selector (I, S, B)
    output reg [31:0] ImmOut      // Sign-extended immediate output
);

    always @(*) begin
        case(ImmSrc)
            `I: ImmOut = {{20{instruction[31]}}, instruction[31:20]};
            `S: ImmOut = {{20{instruction[31]}}, instruction[31:25], instruction[11:7]};
            `B: ImmOut = {{19{instruction[31]}}, instruction[31], instruction[7],
                              instruction[30:25], instruction[11:8], 1'b0};
            default: ImmOut = 32'bx;
        endcase
    end

endmodule
